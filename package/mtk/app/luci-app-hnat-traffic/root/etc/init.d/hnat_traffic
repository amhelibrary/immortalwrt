#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# MediaTek Filogic 880 (MT7988) PPE Hardware MIB Traffic Accounting Daemon

USE_PROCD=1
START=90
STOP=10

PROG=/usr/bin/hnat_trafficd

start_service() {
	# Ensure debugfs is mounted before daemon starts
	[ -d /sys/kernel/debug/hnat ] || mount -t debugfs none /sys/kernel/debug 2>/dev/null

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /tmp/hnat_traffic_cache.json /tmp/hnat_traffic_cache.json.tmp 2>/dev/null
}
