 	if (IS_LAN_GRP(dev) || IS_WAN(dev)) { /* Forward to GMAC Ports */
 		master_dev = (struct net_device *)dev;
 		port_id = hnat_dsa_get_port(&master_dev);
@@ -2844,6 +2912,20 @@ hnat_entry_bind:
