 #define LAN_DEV_NAME hnat_priv->lan
 #define LAN2_DEV_NAME hnat_priv->lan2
 #define IS_ETH_GRP(dev) (IS_LAN_GRP(dev) || IS_WAN(dev))
-#define IS_WAN(dev) (!strncmp((dev)->name, WAN_DEV_NAME, strlen(WAN_DEV_NAME)))
+#define IS_WAN(dev) is_hnat_wan_dev(dev)
 #define IS_LAN_GRP(dev) (IS_LAN(dev) | IS_LAN2(dev))
-#define IS_LAN(dev)								\
-	(!strncmp(dev->name, LAN_DEV_NAME, strlen(LAN_DEV_NAME)) ||		\
-	 IS_BOND(dev))
+#define IS_LAN(dev) is_hnat_lan_dev(dev)
 #define IS_LAN2(dev)								\
 	(!strncmp(dev->name, LAN2_DEV_NAME, strlen(LAN2_DEV_NAME)) ||		\
 	 IS_BOND(dev))
@@ -1455,6 +1453,90 @@ enum FoeIpAct {
 extern const struct of_device_id of_hnat_match[];
 extern struct mtk_hnat *hnat_priv;
 
+static inline bool is_hnat_wan_dev(const struct net_device *dev)
+{
+	if (!dev || !dev->name[0])
+		return false;
+
+	if (netif_is_bridge_port(dev)) {
+		struct net_device *br;
+
+		rcu_read_lock();
+		br = netdev_master_upper_dev_get_rcu((struct net_device *)dev);
+		if (br) {
+			if (!strncmp(br->name, "br-wan", 6)) {
+				rcu_read_unlock();
+				return true;
+			}
+			if (!strncmp(br->name, "br-lan", 6)) {
+				rcu_read_unlock();
+				return false;
+			}
+		}
+		rcu_read_unlock();
+	}
+
+	if (hnat_priv && hnat_priv->wan[0] &&
+	    !strncmp(dev->name, hnat_priv->wan, strlen(hnat_priv->wan)))
+		return true;
+
+	if (!strncmp(dev->name, "wan", 3))
+		return true;
+
+	if (!strcmp(dev->name, "sfp-wan"))
+		return true;
+
+	if (!strncmp(dev->name, "br-wan", 6))
+		return true;
+
+	if (!strncmp(dev->name, "pppoe-", 6))
+		return true;
+
+	return false;
+}
+
+static inline bool is_hnat_lan_dev(const struct net_device *dev)
+{
+	if (!dev || !dev->name[0])
+		return false;
+
+	if (netif_is_bridge_port(dev)) {
+		struct net_device *br;
+
+		rcu_read_lock();
+		br = netdev_master_upper_dev_get_rcu((struct net_device *)dev);
+		if (br) {
+			if (!strncmp(br->name, "br-lan", 6)) {
+				rcu_read_unlock();
+				return true;
+			}
+			if (!strncmp(br->name, "br-wan", 6)) {
+				rcu_read_unlock();
+				return false;
+			}
+		}
+		rcu_read_unlock();
+	}
+
+	if (hnat_priv && hnat_priv->lan[0] &&
+	    !strncmp(dev->name, hnat_priv->lan, strlen(hnat_priv->lan)))
+		return true;
+
+	if (!strncmp(dev->name, "lan", 3))
+		return true;
+
+	if (!strcmp(dev->name, "sfp-lan"))
+		return true;
+
+	if (!strncmp(dev->name, "br-lan", 6))
+		return true;
+
+	if (!strncmp(dev->name, "bond", 4))
+		return true;
+
+	return false;
+}
+
 int hnat_dsa_fill_stag(const struct net_device *netdev,
 		       struct foe_entry *entry,
 		       u16 eth_proto, int mape);
