 	if (dsa_user_dev_check(master_dev))
 		hnat_dsa_get_port(&master_dev);
 
@@ -425,8 +444,8 @@ int nf_hnat_netdevice_event(struct notif
 	case NETDEV_CHANGE:
 		hnat_handle_ext_eth_link_change(dev);
 
-		/* Clear PPE entries if the slave of bond device physical link down */
-		if (!netif_is_bond_slave(dev) ||
+		/* Clear PPE entries if the slave of bond/bridge device physical link down */
+		if ((!netif_is_bond_slave(dev) && !netif_is_bridge_port(dev)) ||
 		    (!IS_LAN_GRP(dev) && !IS_WAN(dev)))
 			break;
 
@@ -1448,6 +1467,41 @@ drop:
 	return NF_DROP;
 }
 
+/* Resolve bridge master to its physical/slave egress port via FDB */
+static struct net_device *hnat_bridge_resolve_port(struct net_device *br_dev,
+						   const unsigned char *dmac,
+						   u16 vid)
+{
+	struct net_bridge *br;
+	struct net_bridge_fdb_entry *f;
+	struct net_bridge_port *dst;
+	struct net_device *egress_dev = NULL;
+
+	if (!br_dev || !netif_is_bridge_master(br_dev))
+		return NULL;
+
+	if (!dmac || !is_valid_ether_addr(dmac))
+		return NULL;
+
+	br = netdev_priv(br_dev);
+	if (!br)
+		return NULL;
+
+	rcu_read_lock();
+	f = br_fdb_find_rcu(br, dmac, vid);
+	if (!f && vid)
+		f = br_fdb_find_rcu(br, dmac, 0);
+
+	if (f && !test_bit(BR_FDB_LOCAL, &f->flags)) {
+		dst = READ_ONCE(f->dst);
+		if (dst && dst->dev)
+			egress_dev = dst->dev;
+	}
+	rcu_read_unlock();
+
+	return egress_dev;
+}
+
 /* Don't bind unknown-unicast (FDB miss) flows to the PPE — that would
  * pin them to one egress port and break bridge MAC learning.
  */
@@ -2211,6 +2265,20 @@ int hnat_bind_crypto_entry(struct sk_buf
 hnat_skip_fill_inner:
 	entry = ppe_fill_info_blk(entry, &hw_path);
 
+	if (netif_is_bridge_master(dev)) {
