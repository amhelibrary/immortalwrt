+static int mt7988_phy_match_device(struct phy_device *phydev,
+				   const struct phy_driver *phydrv)
+{
+	struct device_node *node;
+
+	if (phydev->phy_id == MTK_GPHY_ID_MT7988)
+		return 1;
+
+	node = dev_of_node(&phydev->mdio.dev);
+	if (node && of_device_is_compatible(node, "ethernet-phy-id03a2.9481"))
+		return 1;
+
+	if (phydev->mdio.bus) {
+		const char *bus_id = phydev->mdio.bus->id;
+		const char *bus_name = phydev->mdio.bus->name;
+
+		if ((bus_id && (!strncmp(bus_id, "mt7530", 6) || !strncmp(bus_id, "mt7531", 6))) ||
+		    (bus_name && (!strncmp(bus_name, "mt7530", 6) || !strncmp(bus_name, "mt7531", 6)))) {
+			if (phydev->mdio.addr <= 3)
+				return 1;
+		}
+	}
+
+	return 0;
+}
