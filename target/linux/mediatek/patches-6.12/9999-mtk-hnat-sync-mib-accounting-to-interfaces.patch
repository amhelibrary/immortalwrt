+static void hnat_mib_sync_handler(struct work_struct *work)
+{
+	struct mtk_hnat *h = hnat_priv;
+	struct foe_entry *entry;
+	u32 ppe_id, index;
+
+	if (!h || !h->data->per_flow_accounting)
+		return;
+
+	for (ppe_id = 0; ppe_id < CFG_PPE_NUM; ppe_id++) {
+		if (!h->foe_table_cpu[ppe_id])
+			continue;
+
+		for (index = 0; index < h->foe_etry_num; index++) {
+			entry = &h->foe_table_cpu[ppe_id][index];
+			if (!entry_hnat_is_bound(entry))
+				continue;
+
+			hnat_get_count(h, ppe_id, index, NULL);
+		}
+	}
+
+	schedule_delayed_work(&_hnat_mib_sync_work, 1 * HZ);
+}
+
+static void hnat_mib_sync_enable(void)
+{
+	INIT_DELAYED_WORK(&_hnat_mib_sync_work, hnat_mib_sync_handler);
+	schedule_delayed_work(&_hnat_mib_sync_work, 1 * HZ);
+}
+
+static void hnat_mib_sync_disable(void)
+{
+	cancel_delayed_work_sync(&_hnat_mib_sync_work);
+}
