-	if (dev->netdev_ops->ndo_flow_offload_stats64_add)
-		dev->netdev_ops->ndo_flow_offload_stats64_add(dev, stats64);
-out_unlock:
+	if (dev)
+		hnat_update_dev_stats(dev, stats64);
 	rcu_read_unlock();
 }
 
@@ -1160,17 +1192,26 @@
 	struct rtnl_link_stats64 tx_stats = { .tx_packets = packets,
 					      .tx_bytes = bytes };
 	struct hnat_accounting *acct;
-	int iif, oif;
+	int iif, oif, iif_vif, oif_vif;
+
+	if (!bytes && !packets)
+		return;
 
 	acct = &h->acct[ppe_id][index];
 	iif = READ_ONCE(acct->iif);
 	oif = READ_ONCE(acct->oif);
+	iif_vif = READ_ONCE(acct->iif_vif);
+	oif_vif = READ_ONCE(acct->oif_vif);
 
 	if (iif)
 		hnat_vif_acct_update_dev(iif, &rx_stats);
+	if (iif_vif && iif_vif != iif)
+		hnat_vif_acct_update_dev(iif_vif, &rx_stats);
 
 	if (oif)
 		hnat_vif_acct_update_dev(oif, &tx_stats);
+	if (oif_vif && oif_vif != oif)
+		hnat_vif_acct_update_dev(oif_vif, &tx_stats);
 }
 
