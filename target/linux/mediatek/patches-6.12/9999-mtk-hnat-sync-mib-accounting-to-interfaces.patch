+static DEFINE_SPINLOCK(mib_read_lock);
+
 static int read_mib(struct mtk_hnat *h, u32 ppe_id,
 	     u32 index, u64 *bytes, u64 *packets)
 {
 	int ret;
 	u32 val, cnt_r0, cnt_r1, cnt_r2, cnt_r3;
+	unsigned long flags;
 
 	if (ppe_id >= CFG_PPE_NUM)
 		return -EINVAL;
 
+	spin_lock_irqsave(&mib_read_lock, flags);
 	writel(index | (1 << 16), h->ppe_base[ppe_id] + PPE_MIB_SER_CR);
 	ret = readx_poll_timeout_atomic(readl, h->ppe_base[ppe_id] + PPE_MIB_SER_CR, val,
 					!(val & BIT_MIB_BUSY), 20, 10000);
 
 	if (ret < 0) {
+		spin_unlock_irqrestore(&mib_read_lock, flags);
 		pr_notice("mib busy, please check later\n");
 		return ret;
 	}
@@ -1130,9 +1135,38 @@
 		*packets = ((cnt_r1 & 0xffff0000) >> 16) +
 			   ((u64)(cnt_r2 & 0xffffff) << 16);
 	}
+	spin_unlock_irqrestore(&mib_read_lock, flags);
 
 	return 0;
+}
+
+static void hnat_update_dev_stats(struct net_device *dev,
+				  const struct rtnl_link_stats64 *stats64)
+{
+	if (!dev)
+		return;
+
+	if (dev->netdev_ops && dev->netdev_ops->ndo_flow_offload_stats64_add) {
+		dev->netdev_ops->ndo_flow_offload_stats64_add(dev, stats64);
+		return;
+	}
+
+	if (dev->tstats) {
+		struct pcpu_sw_netstats *tstats = this_cpu_ptr(dev->tstats);
 
+		u64_stats_update_begin(&tstats->syncp);
+		u64_stats_add(&tstats->rx_packets, stats64->rx_packets);
+		u64_stats_add(&tstats->rx_bytes, stats64->rx_bytes);
+		u64_stats_add(&tstats->tx_packets, stats64->tx_packets);
+		u64_stats_add(&tstats->tx_bytes, stats64->tx_bytes);
+		u64_stats_update_end(&tstats->syncp);
+		return;
+	}
+
+	dev->stats.rx_packets += stats64->rx_packets;
+	dev->stats.rx_bytes += stats64->rx_bytes;
+	dev->stats.tx_packets += stats64->tx_packets;
+	dev->stats.tx_bytes += stats64->tx_bytes;
 }
 
